//数组中元素>0就+1，<0就-1，=0不变
Random r2 = new Random();
int[] rawE = new int[10];
for (int i = 0; i < rawE.Length; i++)
{
    rawE[i] = r2.Next(-10, 11);
    Console.WriteLine(rawE[i]);
    if (rawE[i] > 0)
    {
        rawE[i]++;
    }
    else if (rawE[i] < 0)
    {
        rawE[i]--;
    }
}
for (int i = 0; i < rawE.Length; i++)
{
    Console.WriteLine(rawE[i]);
}

