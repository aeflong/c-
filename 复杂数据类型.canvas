		{"id":"1c6ff87dcb544b89","type":"text","text":"获取数组中元素(数组中下标和索引从0开始)","x":764,"y":451,"width":250,"height":60},
		{"id":"91a69e35a7c08e46","type":"text","text":"修改数组中元素","x":764,"y":511,"width":250,"height":60},
		{"id":"c17fe12a3f6f1a81","type":"text","text":"Console.WriteLine(array[0]);","x":1060,"y":451,"width":271,"height":60},
		{"id":"b485694686ab2658","type":"text","text":"array[0] = 100;","x":1060,"y":511,"width":250,"height":60},
		{"id":"4442c7fd8b989ee2","type":"text","text":"数组使用","x":440,"y":511,"width":250,"height":60},
		{"id":"0a964b51d2566bd6","type":"text","text":"//for循环时int i=0;会先执行一遍才开始循环\n`\n`for (int i=0; i < array.Length;++i)\n`{`\n    `Console.WriteLine(array[i]);`\n`}`","x":1060,"y":572,"width":340,"height":178},
		{"id":"179380a03273adaa","type":"text","text":"遍历(打印)数组","x":764,"y":631,"width":250,"height":60},
		{"id":"f50e52fe4ed2cf29","type":"text","text":"数组初始化后不能修改长度","x":764,"y":905,"width":250,"height":60},
		{"id":"f50928fe5a3988eb","type":"text","text":"增加数组元素","x":1060,"y":845,"width":250,"height":60},
		{"id":"b0ffc7658720c80c","type":"text","text":"`int[] array2 = new int[6]增加长度/[4]删减长度;`\n`for (int i = 0; i < array/array3(选短的进行遍历).Length; i++)`\n`{`\n    `array2[i] = array[i];//i的值不能超过array的长度`\n`}`\n`array = array2;//把新列表赋值给原列表来增加数组长度，从而增加数组元素`\n`for (int i = 0; i < array.Length; ++i)//for循环时int i=0;会先执行一遍才开始循环`\n`{`\n    `Console.WriteLine(array[i]);`\n`}`","x":1460,"y":790,"width":640,"height":290},
		{"id":"614d9d787e488a8a","type":"text","text":"删减数组元素","x":1060,"y":965,"width":250,"height":60},
		{"id":"b86484376ab9ceac","type":"text","text":"查找数组元素","x":764,"y":1169,"width":250,"height":57},
		{"id":"ca8fa20db2be2011","type":"text","text":"`int a = 2;`\n`for (int i = 0;i < array.Length; ++i)`\n`{`\n    `if (a == array[i])`\n\t    `{`\n        `Console.WriteLine(\"第{0}个数和a相同\",i);`\n\t    `}`\n`}`","x":1060,"y":1085,"width":419,"height":225},
